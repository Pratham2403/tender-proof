# MongoDB connection string (local or Atlas)
MONGODB_URL=mongodb://localhost:27017/tenderproof

# Redis broker / result backend for Celery
REDIS_URL=redis://localhost:6379/0

# Google AI Studio key — used by SchemaCompiler (Gemini 2.0 Flash)
GOOGLE_API_KEY=your_google_ai_studio_key

# OpenRouter key — used by VisionExtractor (Qwen2.5-VL-72B free tier)
OPENROUTER_API_KEY=your_openrouter_key

# Where uploaded tender / bidder files are stored
UPLOAD_DIR=./uploads

# Extractions below this confidence always route to human review
CONFIDENCE_THRESHOLD=0.70

# Comma-separated origins allowed by CORS (the Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000
